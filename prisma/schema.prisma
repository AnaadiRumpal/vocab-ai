generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  captureToken  String    @unique @default(uuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  words         Word[]
}

model Word {
  id          String     @id @default(cuid())
  userId      String
  term        String
  normalized  String
  kind        TermKind @default(WORD)
  sourceText  String?

  partOfSpeech String?
  meaning      String
  plainEnglish String?
  examples     Json
  synonyms     Json
  mnemonic     String?
  etymology     String?
  difficulty   Int?

  status      WordStatus @default(NEW)

  reviewCount Int      @default(0)
  easeFactor  Float    @default(2.5)
  interval    Int      @default(0)
  dueAt       DateTime @default(now())

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews      ReviewLog[]

  @@unique([userId, normalized])
  @@index([userId, dueAt])
}

model ReviewLog {
  id         String       @id @default(cuid())
  wordId     String
  userId     String
  rating     ReviewRating
  reviewedAt DateTime     @default(now())

  word       Word         @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@index([wordId])
}

enum WordStatus {
  NEW
  LEARNING
  REVIEWING
  MASTERED
  ARCHIVED
}

enum ReviewRating {
  FORGOT
  HARD
  GOOD
  EASY
}

enum TermKind {
  WORD
  PHRASE
  IDIOM
  PHRASAL_VERB
  TECHNICAL_TERM
  OTHER
}